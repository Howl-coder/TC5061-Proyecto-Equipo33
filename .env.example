# Copia este archivo como .env y ajusta los valores. .env está en .gitignore: nunca lo versiones.
# Las variables definidas en el sistema tienen prioridad sobre las de .env.

# Servidor de MLflow Tracking / Model Registry
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si el servidor de MLflow exige autenticación (MLflow las lee automáticamente)
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
